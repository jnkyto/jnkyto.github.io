{
  "name": "kytonie.me",
  "homepage": "https://kytonie.me/",
  "version": "3.4.1",
  "private": true,
  "dependencies": {
    "babel-plugin-formatjs": "^13.0",
    "dotenv": "^18.0",
    "jquery": "^4.0",
    "moment": "^2.31",
    "react": "^19.3",
    "react-dom": "^19.3",
    "react-icons": "^5.7.0",
    "react-intl": "^12.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18",
    "remark-gfm": "^4.0.1"
  },
  "scripts": {
    "start": "vite",
    "build": "npm run generate:sitemap && vite build",
    "serve": "vite preview",
    "check": "prettier --check . && eslint src/",
    "fix": "prettier --write . && eslint --fix src/",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@formatjs/cli": "^6.16",
    "@types/eslint": "^9.6",
    "@types/node": "^26.6",
    "@types/react": "^19.3",
    "@types/react-dom": "^19.3",
    "@typescript-eslint/eslint-plugin": "^8.58",
    "@typescript-eslint/parser": "^8.58",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12",
    "gh-pages": "^6.3",
    "globals": "^17.13",
    "jiti": "^2.7",
    "mini-css-extract-plugin": "^2.10",
    "npm-check-updates": "^23.1.0",
    "prettier": "3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58",
    "vite": "^8.3.3"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  }
}
