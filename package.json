{
  "name": "kytonie.me",
  "homepage": "https://kytonie.me/",
  "version": "3.4.1",
  "private": true,
  "dependencies": {
    "babel-plugin-formatjs": "^11.2",
    "dotenv": "^17.3",
    "jquery": "^4.0",
    "moment": "^2.30",
    "react": "^19.2",
    "react-dom": "^19.2",
    "react-icons": "^5.5.0",
    "react-intl": "^8.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13",
    "remark-gfm": "^4.0.1"
  },
  "scripts": {
    "start": "vite",
    "build": "npm run generate:sitemap && vite build",
    "serve": "vite preview",
    "check": "prettier --check . && eslint src/",
    "fix": "prettier --write . && eslint --fix src/",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/cli": "^7.28",
    "@babel/core": "^7.28",
    "@eslint/js": "^10.0.1",
    "@formatjs/cli": "^6.13",
    "@types/eslint": "^9.6",
    "@types/node": "^25.3",
    "@types/react": "^19.2",
    "@types/react-dom": "^19.2",
    "@typescript-eslint/eslint-plugin": "^8.56",
    "@typescript-eslint/parser": "^8.56",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^10.0",
    "gh-pages": "^6.3",
    "globals": "^17.3",
    "jiti": "^2.6",
    "mini-css-extract-plugin": "^2.10",
    "prettier": "3.8.1",
    "typescript": "^5.9",
    "typescript-eslint": "^8.56",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  }
}
